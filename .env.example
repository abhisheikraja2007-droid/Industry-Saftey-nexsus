# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://safety_user:your_postgres_password@postgres:5432/safety_db
POSTGRES_USER=safety_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=safety_db

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MQTT ───────────────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ─── AI / LLM ───────────────────────────────────────────────
# Set OPENAI_API_KEY to use GPT-4o cloud inference
# Leave blank to use built-in rule-based fallback (no external API needed)
OPENAI_API_KEY=

# ─── Kaggle (optional) ──────────────────────────────────────
# Leave blank to use synthetic data generator (works without Kaggle)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here

# ─── App ────────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-long-random-string-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
